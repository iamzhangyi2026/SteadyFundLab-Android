<?xml version="1.0" encoding="utf-8"?>
<!--
  自适应图标的背景：蓝 -> 青竖向渐变。
  颜色和方向跟 tools/make-icon.py 里的 C_TOP / C_BOTTOM 保持一致
  （#3B6EF6 -> #0D9488，自上而下），这样传统方形图标和自适应图标看起来是同一个。

  为什么非得有这个文件：
    mipmap-anydpi-v26/ic_launcher.xml 原来把背景指向 @color/ic_launcher_background，
    那个值是纯白 #FFFFFF；而前景 ic_launcher_foreground.png 是「透明底 + 白色笔画」的
    象形「基」—— 白笔画画在白底上，桌面上看到的就是一块白板。
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:type="linear"
        android:angle="270"
        android:startColor="#3B6EF6"
        android:endColor="#0D9488" />
</shape>
